{
  "name": "ironcrew-next",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "26.4.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types apps/control/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "node dist/apps/control/main.js",
    "setup": "node apps/cli/main.ts setup",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.mjs",
    "format:check": "prettier --check apps packages tests scripts *.json *.ts *.mjs",
    "lint": "eslint apps packages tests scripts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:recovery": "vitest run tests/recovery",
    "test:install": "vitest run tests/install",
    "test:live": "node scripts/live.ts",
    "build": "node scripts/build-site-runtime.ts && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.ts && vite build --config apps/web/vite.config.ts",
    "openapi:check": "node scripts/openapi.ts --check"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "argon2": "0.45.1",
    "cron-parser": "5.5.0",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "imapflow": "1.7.8",
    "mailparser": "3.9.22",
    "nodemailer": "9.1.1",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.61.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tar": "7.5.22",
    "three": "0.185.1",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "1.61.0",
    "@types/express": "5.0.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "25.9.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "6.0.3",
    "@types/three": "0.185.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.3",
    "prettier": "3.8.4",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "8.0.16",
    "vitest": "3.2.6"
  }
}
