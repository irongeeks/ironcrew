# /etc/ironcrew/runner.env — Konfiguration des Runner-Dienstes.
#
# chmod 600, Eigentümer ironcrew-runner. Diese Datei enthält das gemeinsame
# Geheimnis für den Socket.
#
# Der Runner hält die CLI-Anmeldungen und startet die MCP-Server, deren
# Zugangsdaten aus dem Tresor kommen. Er braucht deshalb absichtlich KEINE
# der übrigen Integrations-Variablen aus ironcrew.env: keine Postfächer, keine
# Messenger-Tokens, keine Suchschlüssel. Was er nicht kennt, kann er nicht
# verlieren.

# Pfad des Unix-Sockets. Muss mit IRONCREW_RUNNER_SOCKET in ironcrew.env
# übereinstimmen.
IRONCREW_RUNNER_SOCKET=/run/ironcrew/runner.sock

# Gemeinsames Geheimnis, identisch mit dem in ironcrew.env. GEHEIM.
# Erzeugen: openssl rand -hex 32
IRONCREW_RUNNER_TOKEN=

# Wurzel aller Arbeitsordner. Der Runner lehnt jeden Job ab, dessen
# Arbeitsordner außerhalb davon liegt — auch dann, wenn die Control Plane ihn
# so verlangt. Ein Runner, der dem übergebenen Pfad vertraut, würde einen
# Fehler in der Control Plane zu Dateizugriff unter dem Konto machen, das die
# Anmeldungen hält.
IRONCREW_RUNNER_WORKSPACE_ROOT=/var/lib/ironcrew/workspaces

# ── Tresor (optional) ──
#
# Nur nötig, wenn ein MCP-Server seine Zugangsdaten als Tresor-Verweis trägt
# ({"$secret": {...}}). Der Runner löst den Verweis beim Start auf — als
# eigener Benutzer, mit eigener Tresor-Sitzung. Die Control Plane sieht den
# Wert nie (docs/THREAT_MODEL.md T-18).
#
# Vaultwarden: URL des Servers; die Anmeldung selbst macht `bw login` einmalig
# als Benutzer ironcrew-runner.
# VAULTWARDEN_SERVER_URL=https://vault.example.com
#
# Proton Pass braucht keine Variable, aber eine eingerichtete `pass-cli`.
# Der OS-Schlüsselbund funktioniert auf einem Server praktisch nicht (keine
# Sitzung, kein D-Bus) — dort Vaultwarden oder Proton Pass verwenden.

# ── OpenRouter auf dem Runner (optional) ──
# Nur Referenz, niemals der API-Key. Wird pro Run im Runner aufgelöst.
# Provider: keychain, protonpass, vaultwarden; optionales Feld: field.
# Proton Pass itemRef ist "<shareId>:<itemId>".
# IRONCREW_OPENROUTER_SECRET_REF='{"provider":"keychain","itemRef":"ironcrew/openrouter"}'
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
# Durable Tool-Audit, außerhalb aller Agent-Workspaces. Fehlschlag blockiert Tools.
# IRONCREW_RUNNER_TOOL_AUDIT=/var/lib/ironcrew-runner/tool-audit.ndjson

# ── Optionaler Remote-mTLS-Listener ──
# Standard ist ausschließlich Unix-Socket. Bei TLS IRONCREW_RUNNER_SOCKET entfernen.
# Loopback-Default; für Remote explizit eine private/VPN-Adresse binden.
# Clientzertifikat einer freigegebenen CA UND gemeinsames Token sind Pflicht.
# IRONCREW_RUNNER_TLS_HOST=127.0.0.1
# IRONCREW_RUNNER_TLS_PORT=7443
# IRONCREW_RUNNER_TLS_CERT_FILE=/etc/ironcrew/tls/runner.pem
# IRONCREW_RUNNER_TLS_KEY_FILE=/etc/ironcrew/tls/runner.key
# IRONCREW_RUNNER_TLS_CLIENT_CA_FILE=/etc/ironcrew/tls/control-plane-ca.pem

# ── Ausgehende Fleet-Verbindung (Alternative ohne eingehenden Runner-Port) ──
# Unix/TLS-Listener-Variablen entfernen; RUNNER_TOKEN ist hier nicht erforderlich.
# Owner erstellt einmaliges Enrollment in der Fleet-Verwaltung (max.15min).
# Enrollment-Token nach dem ersten Start aus dieser privaten Datei entfernen.
# IRONCREW_FLEET_URL=wss://control.example:9443/api/crew/fleet/connect
# IRONCREW_FLEET_CREDENTIAL_FILE=/var/lib/ironcrew-runner/fleet-credential.json
# IRONCREW_FLEET_ENROLLMENT_TOKEN=<one-time-enrollment-token>
# IRONCREW_FLEET_CA_FILE=/etc/ironcrew/tls/company-ca.crt
# Workspace-Root muss exakt mit der Owner-Registrierung übereinstimmen.
# IRONCREW_RUNNER_WORKSPACE_ROOT=/var/lib/ironcrew/workspaces
# Details: docs/RUNNER_FLEET.md
