<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>eu.irongeeks.ironcrew</string>
<key>UserName</key><string>ironcrew</string>
<key>GroupName</key><string>ironcrew</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/node</string><string>/opt/ironcrew/scripts/service-start.mjs</string><string>/etc/ironcrew/ironcrew.env</string><string>control</string></array>
<key>WorkingDirectory</key><string>/opt/ironcrew</string>
<key>EnvironmentVariables</key><dict><key>NODE_ENV</key><string>production</string><key>HOME</key><string>/var/lib/ironcrew</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>10</integer>
<key>ExitTimeOut</key><integer>30</integer>
<key>Umask</key><integer>23</integer>
<key>StandardOutPath</key><string>/var/lib/ironcrew/service.log</string>
<key>StandardErrorPath</key><string>/var/lib/ironcrew/service-error.log</string>
</dict></plist>
