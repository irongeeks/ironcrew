# IronCrew service environment — installed to /etc/ironcrew/ironcrew.env
#
# THIS FILE HOLDS SECRETS (bot tokens, OAuth client secrets, SMTP passwords).
# It must be owned by the service user and chmod 600:
#   sudo chown ironcrew:ironcrew /etc/ironcrew/ironcrew.env
#   sudo chmod 600 /etc/ironcrew/ironcrew.env
# scripts/install-service.sh does this for you and never overwrites an existing
# file. Restart after editing: sudo systemctl restart ironcrew
#
# Format: systemd EnvironmentFile — KEY=value, one per line, no `export`, no
# shell expansion ($VAR is NOT substituted). Quotes are stripped by IronCrew's
# own loader, but plain unquoted values are the safe choice here.
#
# Lines marked [SECRET] must never be committed, logged or copied into a ticket.
# Everything commented out is optional; the feature stays inactive until its
# variables are set.

# ---------------------------------------------------------------------------
# Core: network and paths
# ---------------------------------------------------------------------------

# Listen port. Default 8790.
PORT=8790

# Bind address. 127.0.0.1 = local only. Use a Tailscale IP for remote access;
# use 0.0.0.0 only behind a reverse proxy you control.
HOST=127.0.0.1

# SQLite database file and log directory. These MUST live under a path listed
# in ReadWritePaths= in deploy/ironcrew.service — /opt/ironcrew/data by
# default. Defaults if unset are relative to the checkout, which is read-only
# under the service sandbox, so set them explicitly.
DB_PATH=/opt/ironcrew/data/ironcrew.sqlite
LOGS_DIR=/opt/ironcrew/data/logs

# error | warn | info | debug. Default: info in production.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Core: background work
# ---------------------------------------------------------------------------

# Master switch for everything the service does on its own: draining the run
# queue, polling mailboxes and messengers. on | off, default on. With off the
# service only answers HTTP requests and never acts by itself — useful for a
# maintenance window or a second read-only instance.
# IRONCREW_SCHEDULER=on

# How often each background job looks, in seconds. The defaults below are the
# built-in ones; raise them on a small machine, lower the queue interval if you
# want the company to feel more immediate. An unusable value (zero, negative,
# not a number) is ignored with a warning in the log rather than applied — a
# typo must not turn the loop into a hot spin against the database.
#
# The queue interval is the latency between "the assistant delegated something"
# and "an agent starts on it", which is the one a person actually feels.
# IRONCREW_SCHEDULER_QUEUE_SECONDS=15
# Mailbox rows carry their own poll interval; this only decides how often that
# question gets asked, so it does not mean "poll every mailbox every minute".
# IRONCREW_SCHEDULER_MAIL_SECONDS=60
# IRONCREW_SCHEDULER_MESSENGER_SECONDS=20
# Housekeeping: expired leases, and dropping finished queue rows after 30 days.
# IRONCREW_SCHEDULER_SWEEP_SECONDS=300

# ---------------------------------------------------------------------------
# Core: secrets and access control
# ---------------------------------------------------------------------------

# [SECRET] REQUIRED. Encrypts OAuth tokens, messenger tokens and mailbox
# credentials at rest in SQLite. Changing it makes existing stored credentials
# undecryptable. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_SECRET=__CHANGE_ME__

# [SECRET] Legacy fallback for OAUTH_ENCRYPTION_SECRET. Only set it if you are
# migrating an installation that already used it.
# SESSION_SECRET=__CHANGE_ME__

# [SECRET] Bearer token for CLI/API clients ("Authorization: Bearer ..."), as
# an alternative to the browser cookie session. Required for any non-loopback
# access. Unset = bearer auth disabled; a random token is generated at boot and
# changes on every restart.
# API_AUTH_TOKEN=__CHANGE_ME__

# [SECRET] Shared secret for the POST /api/inbox webhook, sent by the caller in
# the x-inbox-secret header.
# INBOX_WEBHOOK_SECRET=__CHANGE_ME__

# Extra trusted browser origins for CORS. ALLOWED_ORIGIN_SUFFIXES defaults to
# ".ts.net" (Tailscale).
# ALLOWED_ORIGINS=https://ironcrew.example.com
# ALLOWED_ORIGIN_SUFFIXES=.ts.net,.example.com

# Public base URL used to build OAuth callback URLs. Set it when the service is
# reached through a reverse proxy or Tailscale name rather than 127.0.0.1.
# OAUTH_BASE_URL=http://127.0.0.1:8790

# Restrict which filesystem roots may be registered as project paths.
# Comma-separated. Empty = no restriction.
# PROJECT_PATH_ALLOWED_ROOTS=/srv/projects,/opt/ironcrew/workspaces

# Directives must reference a bound project. Set to 0 only for temporary local
# debugging. Default 1.
# ENFORCE_DIRECTIVE_PROJECT_BINDING=1

# [SECRET] Keyed hash for the tamper-evident security audit log. Without a key
# the chain is unkeyed and only detects accidental corruption, not an attacker
# who can rewrite the log. Verify with: pnpm run audit:verify
# SECURITY_AUDIT_CHAIN_KEY=__CHANGE_ME__
# SECURITY_AUDIT_CHAIN_SEED=office-zero-security-audit-v1

# ---------------------------------------------------------------------------
# OAuth providers (browser login for GitHub / Google runtimes)
# Unset = that provider's login is simply unavailable.
# ---------------------------------------------------------------------------

# OAUTH_GITHUB_CLIENT_ID=
# [SECRET]
# OAUTH_GITHUB_CLIENT_SECRET=__CHANGE_ME__

# OAUTH_GOOGLE_CLIENT_ID=
# [SECRET]
# OAUTH_GOOGLE_CLIENT_SECRET=__CHANGE_ME__

# Explicit Gemini OAuth credentials, if they differ from the Google pair above.
# GEMINI_OAUTH_CLIENT_ID=
# [SECRET]
# GEMINI_OAUTH_CLIENT_SECRET=__CHANGE_ME__

# ---------------------------------------------------------------------------
# Model providers (API-key runtimes)
# Prefer a secret store over this file for these — see docs/PROVIDER_AUTH.md.
# ---------------------------------------------------------------------------

# [SECRET]
# OPENAI_API_KEY=__CHANGE_ME__
# [SECRET] Also settable at runtime through the CLI-auth screen.
# ANTHROPIC_API_KEY=__CHANGE_ME__
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_PROJECT_ID=

# ---------------------------------------------------------------------------
# Outbound notification channels (decision inbox fan-out)
# Each channel activates only once ALL of its variables are set.
# ---------------------------------------------------------------------------

# Discord webhook: Server Settings -> Integrations -> Webhooks -> New Webhook.
# [SECRET] the webhook URL contains its own token.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Telegram: create a bot via @BotFather. TELEGRAM_BOT_TOKEN alone also enables
# the INBOUND Telegram channel (IronCrew reads replies); adding
# TELEGRAM_CHAT_ID enables outbound notifications to that chat.
# [SECRET]
# TELEGRAM_BOT_TOKEN=__CHANGE_ME__
# TELEGRAM_CHAT_ID=123456789

# SMTP send only — an outbound notification channel, not a mailbox IronCrew
# reads from. Needs at least SMTP_HOST, SMTP_FROM and SMTP_TO.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=bot@example.com
# [SECRET]
# SMTP_PASS=__CHANGE_ME__
# SMTP_FROM=IronCrew <bot@example.com>
# SMTP_TO=owner@example.com

# ---------------------------------------------------------------------------
# Inbound messengers
# ---------------------------------------------------------------------------

# Discord inbound needs BOTH: a bot token and the channel to listen on.
# [SECRET]
# DISCORD_BOT_TOKEN=__CHANGE_ME__
# DISCORD_INBOUND_CHANNEL_ID=123456789012345678

# Mailboxes (IMAP / JMAP / Microsoft 365 / Gmail) need no variables here: each
# mailbox carries its own host and credentials, configured per mailbox in the
# Command Center under "E-Mail" (docs/MAIL.md). They do require
# OAUTH_ENCRYPTION_SECRET above — that is what encrypts them at rest.

# ---------------------------------------------------------------------------
# Integrations — unregistered until set (the UI reports "not registered")
# ---------------------------------------------------------------------------

# Local memory is always registered. Default vault: data/vault (relative to
# WorkingDirectory); set an explicit writable persistent path for a service.
# Notes are written below <vault>/IronCrew/<kind>/. A path under /home is hidden
# by ProtectHome=true; use /srv or configure the unit's BindPaths deliberately.
# OBSIDIAN_VAULT_PATH=/srv/obsidian/MyVault
# Versioned memory policy (default config/memory.yaml). Honcho is disabled by
# default; configure its endpoint, sensitivity and SecretRef in YAML, no raw key.
# IRONCREW_MEMORY_CONFIG=/opt/ironcrew/config/memory.yaml

# Tailscale CLI, used for network status. Defaults to `tailscale` on PATH.
# TAILSCALE_BIN=/usr/bin/tailscale

# Vaultwarden / Bitwarden secret provider. BW_PASSWORD unlocks the vault when
# no session is supplied; BW_SESSION is a pre-unlocked session key.
# VAULTWARDEN_SERVER_URL=https://vault.example.com
# [SECRET]
# BW_PASSWORD=__CHANGE_ME__
# [SECRET]
# BW_SESSION=__CHANGE_ME__

# Figma (design workflows). The first of these three that is set wins.
# [SECRET]
# FIGMA_ACCESS_TOKEN=__CHANGE_ME__
# FIGMA_API_TOKEN=__CHANGE_ME__
# FIGMA_PERSONAL_ACCESS_TOKEN=__CHANGE_ME__

# ---------------------------------------------------------------------------
# Updates
#
# Auto-update rewrites the checkout in /opt, which ProtectSystem=strict makes
# read-only for this service. Leave AUTO_UPDATE_ENABLED off on a systemd
# install and update by hand (deploy/README.md). The update CHECK is read-only
# and safe to leave on.
# ---------------------------------------------------------------------------

# UPDATE_CHECK_ENABLED=1
# UPDATE_CHECK_REPO=Chepko932/OctoOffice
# UPDATE_CHECK_TTL_MS=1800000
# UPDATE_CHECK_TIMEOUT_MS=4000

AUTO_UPDATE_ENABLED=0
# AUTO_UPDATE_CHANNEL=stable
# AUTO_UPDATE_TARGET_BRANCH=main
# AUTO_UPDATE_IDLE_ONLY=1
# notify | exit | command — "exit" relies on Restart=on-failure to bring the
# service back; with systemd, "notify" plus a manual restart is the honest one.
# AUTO_UPDATE_RESTART_MODE=notify
# AUTO_UPDATE_RESTART_COMMAND=
# AUTO_UPDATE_CHECK_INTERVAL_MS=1800000
# AUTO_UPDATE_INITIAL_DELAY_MS=60000
# AUTO_UPDATE_EXIT_DELAY_MS=10000
# AUTO_UPDATE_TOTAL_TIMEOUT_MS=900000
# AUTO_UPDATE_GIT_FETCH_TIMEOUT_MS=120000
# AUTO_UPDATE_GIT_PULL_TIMEOUT_MS=180000
# AUTO_UPDATE_INSTALL_TIMEOUT_MS=300000
# AUTO_UPDATE_COMMAND_OUTPUT_MAX_CHARS=200000

# ---------------------------------------------------------------------------
# Observability (OpenTelemetry). Disabled by default.
# ---------------------------------------------------------------------------

# OTLP_ENABLED=false
# OTLP_ENDPOINT=https://otlp.example.com/v1/traces
# OTLP_EXPORT_INTERVAL_MS=60000
# [SECRET] if it carries an authorization header.
# OTLP_HEADERS=authorization=Bearer%20xxx,x-tenant=my-tenant

# ---------------------------------------------------------------------------
# Tuning (advanced; defaults are fine)
# ---------------------------------------------------------------------------

# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_BUSY_RETRY_MAX_ATTEMPTS=5
# REVIEW_MAX_ROUNDS=3
# REVIEW_MAX_REVISION_SIGNALS_PER_DEPT_PER_ROUND=2
# REVIEW_MEETING_ONESHOT_TIMEOUT_MS=65000
# MEETING_PROMPT_TASK_CONTEXT_MAX_CHARS=1200
# MEETING_TRANSCRIPT_MAX_TURNS=20
# MEETING_TRANSCRIPT_LINE_MAX_CHARS=180
# MEETING_TRANSCRIPT_TOTAL_MAX_CHARS=2400
# IN_PROGRESS_ORPHAN_GRACE_MS=120000
# IN_PROGRESS_ORPHAN_SWEEP_MS=30000
# SUBTASK_DELEGATION_SWEEP_MS=15000

# NODE_ENV is set by the unit file (production) — do not set it here.

# --- Werkzeuge -------------------------------------------------------------
# Websuche. Beide optional; ohne Konfiguration ist kein Anbieter registriert
# und /api/crew/search-providers meldet ehrlich eine leere Liste.
# Selbst gehostetes SearXNG — bevorzugt, weil die Anfragen im Haus bleiben.
#SEARXNG_URL=https://searx.intern.example
# Brave Search API. GEHEIM.
#BRAVE_SEARCH_API_KEY=

# --- Laufzeiten ------------------------------------------------------------
# OpenRouter läuft produktiv im nativen Runner. Der Schlüssel wird dort pro Run
# über IRONCREW_OPENROUTER_SECRET_REF aufgelöst; siehe ironcrew-runner.env.example
# und docs/RUNNER_PROTOCOL.md. Kein API-Key in dieser Control-Plane-Umgebung nötig.
# Die Vendor-Policy gilt bei jeder Anfrage einschließlich Tool-Fortsetzungen.
# Nur lokale Entwicklung OHNE Runner und mit NODE_ENV != production:
# IRONCREW_EMBEDDED_OPENROUTER=1
# OPENROUTER_API_KEY=
# OPENROUTER_DEFAULT_MODEL=

# --- Runner ----------------------------------------------------------------
# Wenn gesetzt, laufen alle CLI-Laufzeiten im Runner-Dienst statt in diesem
# Prozess — dann hält diese Control Plane keine CLI-Anmeldung mehr.
# Muss in BEIDEN Env-Dateien identisch stehen (hier und /etc/ironcrew/runner.env).
#IRONCREW_RUNNER_SOCKET=/run/ironcrew/runner.sock
# Gemeinsames Geheimnis für die Socket-Verbindung. GEHEIM.
# Erzeugen: openssl rand -hex 32
#IRONCREW_RUNNER_TOKEN=

# ── Gewerke: Integrationen der Business-Packs (docs/BUSINESS_PACKS.md) ──
#
# Alle sieben Adapter sind rein lesend, und keiner wird geladen, solange seine
# Variablen fehlen. Genau das ist der Feature-Flag: was hier nicht steht,
# meldet sich in der Oberfläche als "nicht konfiguriert" statt als Schalter,
# der beim Drücken scheitert.
#
# Tokens bitte beim Anbieter so eng wie möglich schneiden — eine PVEAuditor-
# Rolle, ein RMM-Schlüssel mit nur den Rechten seiner Rolle. Ein lesender
# Zugang ist immer noch ein Zugang: er beschreibt einem Angreifer den ganzen
# Bestand.

# Proxmox VE — Bestand und Backup-Status lesen.
# Token anlegen: Rechenzentrum → Berechtigungen → API-Tokens, Rolle PVEAuditor.
# PROXMOX_URL=https://pve.intern.example:8006
# PROXMOX_TOKEN_ID=ironcrew@pve!readonly
# PROXMOX_TOKEN_SECRET=

# Tactical RMM — Agenten, Alarme, Patch-Stand lesen.
# TACTICAL_RMM_URL=https://api.rmm.intern.example
# TACTICAL_RMM_API_KEY=

# UniFi Network — Geräte und Clients lesen (UniFi OS, X-API-KEY).
# Selbstsignierte Zertifikate werden NICHT umgangen: die CA gehört ins
# Betriebssystem, sonst kann der Adapter seine Konsole nicht von einem
# Angreifer unterscheiden.
# UNIFI_URL=https://unifi.intern.example
# UNIFI_API_KEY=
# UNIFI_SITE=default

# Lexware Office — offene Posten und Rechnungen lesen. Bucht und zahlt nichts.
# Achtung: api.lexoffice.io ist abgeschaltet, der Standard ist api.lexware.io.
# Limit: 2 Anfragen pro Sekunde über alle Endpunkte.
# LEXWARE_OFFICE_API_KEY=
# LEXWARE_OFFICE_URL=https://api.lexware.io

# Anmeldung über ein Verzeichnis (OIDC, z. B. Authentik) — docs/IDENTITY.md.
# Aus, solange IRONCREW_OIDC_ISSUER nicht gesetzt ist. Der Passwort-Login
# bleibt in jedem Fall bestehen: der Tag, an dem das Verzeichnis nicht geht,
# ist genau der Tag, an dem sich jemand anmelden und es reparieren muss.
# IRONCREW_OIDC_ISSUER=https://idp.intern.example/application/o/ironcrew/
# IRONCREW_OIDC_CLIENT_ID=
# IRONCREW_OIDC_CLIENT_SECRET=
# IRONCREW_OIDC_REDIRECT_URI=https://crew.intern.example/api/crew/auth/oidc/callback
# refuse (Standard) | link-verified-email | create. "refuse" heisst: ein
# Verzeichnis-Konto ohne verknüpftes IronCrew-Konto kommt nicht rein. Ein
# Verzeichnis kennt alle — das ist kein Grund, allen ein Konto zu geben.
# IRONCREW_OIDC_PROVISIONING=refuse
# Nur bei "create". "owner" wird abgelehnt.
# IRONCREW_OIDC_CREATE_ROLE=viewer

# Audit-Kette ausser Haus (docs/AUDIT_SHIPPING.md). Aus, solange nichts gesetzt
# ist. Die Kette beweist, dass niemand Einträge GEÄNDERT hat — nicht, dass
# niemand sie GELÖSCHT hat. Dafür braucht es eine Kopie dort, wohin die
# Zugangsdaten dieser Kiste nicht reichen. Ein Dateiziel auf derselben Platte
# bringt nichts: wer die Tabelle löschen kann, löscht die Datei gleich mit.
# IRONCREW_AUDIT_SINK=file
# IRONCREW_AUDIT_FILE=/mnt/audit-archiv/ironcrew.ndjson
# IRONCREW_AUDIT_SINK=http
# IRONCREW_AUDIT_URL=https://collector.intern.example/ingest
# IRONCREW_AUDIT_TOKEN=
# Standard: alle 60 Sekunden.
# IRONCREW_SCHEDULER_AUDIT_SHIP_SECONDS=60

# sevDesk — Belege und Rechnungen lesen. Alternative zu Lexware Office: setz
# das System, das du ohnehin führst, nicht beide. Der Schlüssel steht in
# sevDesk unter Einstellungen -> Benutzer -> Benutzer (32 Zeichen).
# Ein Limit veröffentlicht sevDesk nicht.
# SEVDESK_API_KEY=
# SEVDESK_URL=https://my.sevdesk.de/api/v1

# Paperless-ngx — Volltextsuche im eigenen Archiv.
# PAPERLESS_URL=https://paperless.intern.example
# PAPERLESS_TOKEN=

# Nextcloud — Ordner lesen. App-Passwort verwenden, nicht das Kontopasswort:
# es ist pro Gerät widerrufbar und kann das Konto nicht ändern.
# NEXTCLOUD_URL=https://cloud.intern.example
# NEXTCLOUD_USER=ironcrew
# NEXTCLOUD_APP_PASSWORD=

# ── Optionaler expliziter Remote-Runner über mTLS ──
# Alternativ zu IRONCREW_RUNNER_SOCKET; niemals gleichzeitig setzen.
# Alle Zertifikatspfade + IRONCREW_RUNNER_TOKEN sind Pflicht. Kein TLS-Downgrade.
# IRONCREW_RUNNER_URL=tls://runner.internal.example:7443
# IRONCREW_RUNNER_CA_FILE=/etc/ironcrew/tls/runner-ca.pem
# IRONCREW_RUNNER_CERT_FILE=/etc/ironcrew/tls/control-plane.pem
# IRONCREW_RUNNER_KEY_FILE=/etc/ironcrew/tls/control-plane.key
