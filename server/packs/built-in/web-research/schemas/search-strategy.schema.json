{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["sub_questions"],
  "properties": {
    "topic_analysis": {
      "type": "string"
    },
    "sub_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": {
            "type": "string"
          },
          "search_keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        }
      }
    }
  }
}
