{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_number", "positive_prompt"],
        "properties": {
          "scene_number": {
            "type": "integer"
          },
          "positive_prompt": {
            "type": "string"
          },
          "negative_prompt": {
            "type": "string"
          },
          "motion_prompt": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number"
          }
        }
      }
    }
  }
}
