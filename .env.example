# OctoOffice server defaults
PORT=8790
HOST=127.0.0.1

# Required: encrypt OAuth + messenger channel tokens stored in SQLite.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_ENCRYPTION_SECRET="__CHANGE_ME__"

# Optional legacy fallback for OAUTH_ENCRYPTION_SECRET
# SESSION_SECRET="__CHANGE_ME__"

# Docker: IP to bind ports to (default: 127.0.0.1 = localhost only).
# Set to your Tailscale IP or 0.0.0.0 for remote access.
# BIND_HOST="100.x.x.x"

# Optional runtime paths (defaults: ./octooffice.sqlite and ./logs)
# DB_PATH="./octooffice.sqlite"
# LOGS_DIR="./logs"

# Optional callback base URL override
# OAUTH_BASE_URL="http://127.0.0.1:8790"

# Optional API auth token (required for non-loopback access)
# API_AUTH_TOKEN="__CHANGE_ME__"

# Remote browser clients provide API_AUTH_TOKEN at runtime.
# It is not embedded in frontend build artifacts.

# Optional extra trusted origins/suffixes for CORS
# ALLOWED_ORIGINS="https://octo.example.com"
# ALLOWED_ORIGIN_SUFFIXES=".ts.net,.example.com"

# GitHub OAuth (Settings -> Developer settings -> OAuth Apps)
# Required for GitHub/Copilot OAuth login. Without these, GitHub OAuth will be unavailable.
# OAUTH_GITHUB_CLIENT_ID="__CHANGE_ME__"
# OAUTH_GITHUB_CLIENT_SECRET="__CHANGE_ME__"

# Google OAuth (Google Cloud Console -> OAuth consent screen)
# Required for Google/Antigravity OAuth login. Without these, Google OAuth will be unavailable.
# OAUTH_GOOGLE_CLIENT_ID="__CHANGE_ME__"
# OAUTH_GOOGLE_CLIENT_SECRET="__CHANGE_ME__"

# Optional explicit Gemini OAuth credentials
# GEMINI_OAUTH_CLIENT_ID="__CHANGE_ME__"
# GEMINI_OAUTH_CLIENT_SECRET="__CHANGE_ME__"

# Optional model provider settings
# OPENAI_API_KEY="__CHANGE_ME__"
# GOOGLE_CLOUD_PROJECT="__CHANGE_ME__"
# GOOGLE_CLOUD_PROJECT_ID="__CHANGE_ME__"

# Optional Figma integration (design workflows)
# FIGMA_ACCESS_TOKEN="__CHANGE_ME__"

# Optional OpenClaw config path override
# OPENCLAW_CONFIG="/path/to/openclaw.json"

# Messenger channel tokens/sessions are now managed in UI Settings.

# Required for /api/inbox webhook endpoint (sent via x-inbox-secret header)
INBOX_WEBHOOK_SECRET=__CHANGE_ME__

# Optional meeting prompt budget tuning
# MEETING_PROMPT_TASK_CONTEXT_MAX_CHARS=1200
# MEETING_TRANSCRIPT_MAX_TURNS=20
# MEETING_TRANSCRIPT_LINE_MAX_CHARS=180
# MEETING_TRANSCRIPT_TOTAL_MAX_CHARS=2400
# REVIEW_MEETING_ONESHOT_TIMEOUT_MS=65000
# Milliseconds. (Backward compatibility: values <= 600 are treated as seconds.)

# Optional log level (error | warn | info | debug). Defaults: debug in dev, info in prod.
# LOG_LEVEL=info

# Optional data paths. Defaults: ./octooffice.sqlite and ./logs/ next to the server.
# DB_PATH=/absolute/path/to/octooffice.sqlite
# LOGS_DIR=/absolute/path/to/logs

# Optional bearer token for CLI/API-only clients. When set, clients may pass
# "Authorization: Bearer $API_AUTH_TOKEN" instead of using the browser cookie
# session. Leave unset to disable bearer auth entirely.
# API_AUTH_TOKEN=

# SQLite tuning (advanced; defaults are usually fine)
# SQLITE_BUSY_TIMEOUT_MS=5000

# Orchestrator scheduler tuning (milliseconds)
# IN_PROGRESS_ORPHAN_GRACE_MS=120000
# IN_PROGRESS_ORPHAN_SWEEP_MS=30000
# SUBTASK_DELEGATION_SWEEP_MS=15000
# REVIEW_MAX_ROUNDS=3

# Optional OpenTelemetry export (observability). Disabled by default.
# OTLP_ENABLED=false
# OTLP_ENDPOINT=https://otlp.example.com/v1/traces
# OTLP_EXPORT_INTERVAL_MS=60000
# OTLP_HEADERS=authorization=Bearer%20xxx,x-tenant=my-tenant

# Optional OpenClaw profile config override (JSON file with CLI profiles)
# OPENCLAW_CONFIG=/path/to/openclaw.json

# Internal one-time migration marker (auto-managed by v1.0.5 runtime migration)
# CLAW_MIGRATION_V1_0_5_DONE=1

# IronCrew: optional integrations, all unregistered (features simply report
# "not registered" in the UI) until set.
# VAULTWARDEN_SERVER_URL="https://vault.example.com"
# TAILSCALE_BIN="/usr/bin/tailscale"
# Obsidian vault path — the first MemoryProvider. Must already exist; agents
# write real .md notes with YAML frontmatter under "<path>/IronCrew/<kind>/".
# OBSIDIAN_VAULT_PATH="/home/user/Documents/MyVault"

# Notification channels — best-effort fan-out for the decision inbox
# (an approval request, for now). Each channel activates only once its own
# variables below are fully set.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook.
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/<id>/<token>"
# Telegram: create a bot via @BotFather, then message it once so it can
# resolve your chat id (e.g. via @userinfobot, or the bot API's getUpdates).
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# TELEGRAM_CHAT_ID="123456789"
# Email (SMTP send only — this is an outbound notification channel, not an
# inbox IronCrew reads from).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="bot@example.com"
# SMTP_PASS="__CHANGE_ME__"
# SMTP_FROM="IronCrew <bot@example.com>"
# SMTP_TO="owner@example.com"
