{
  "name": "ironcrew",
  "private": true,
  "version": "2.7.0",
  "description": "Self-hosted, local-first multi-agent company OS: an executive assistant triages your directives, delegates to a crew of specialist agents, and reports back under a governance-grade control plane.",
  "license": "Apache-2.0",
  "author": "IronGeeks",
  "homepage": "https://github.com/irongeeks/ironcrew#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/irongeeks/ironcrew.git"
  },
  "bugs": {
    "url": "https://github.com/irongeeks/ironcrew/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "agent-orchestration",
    "pixi-js",
    "mission-control",
    "workflow-packs",
    "mcp",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "migrate:v1.0.5": "node scripts/auto-apply-v1.0.5.mjs",
    "migrate:custom-skills": "node scripts/migrate-custom-skills-canonical.mjs",
    "predev": "node scripts/auto-apply-v1.0.5.mjs",
    "predev:local": "node scripts/auto-apply-v1.0.5.mjs",
    "predev:e2e": "node scripts/auto-apply-v1.0.5.mjs",
    "predev:tailscale": "node scripts/auto-apply-v1.0.5.mjs",
    "prestart": "node scripts/auto-apply-v1.0.5.mjs && node scripts/ensure-remotion-runtime.mjs",
    "prestart:tailscale": "node scripts/auto-apply-v1.0.5.mjs && node scripts/ensure-remotion-runtime.mjs",
    "dev": "concurrently -n web,api -c cyan,magenta \"cross-env VITE_DEV=1 vite --host 0.0.0.0 --port 8800\" \"cross-env VITE_DEV=1 HOST=0.0.0.0 nodemon --watch server --ext ts --exec tsx server/index.ts\"",
    "dev:local": "concurrently -n web,api -c cyan,magenta \"cross-env VITE_DEV=1 vite --host 127.0.0.1 --port 8800\" \"cross-env VITE_DEV=1 HOST=127.0.0.1 nodemon --watch server --ext ts --exec tsx server/index.ts\"",
    "dev:e2e": "node scripts/prepare-e2e-runtime.mjs && cross-env VITE_DEV=1 HOST=127.0.0.1 DB_PATH=.tmp/e2e-runtime/ironcrew.e2e.sqlite LOGS_DIR=.tmp/e2e-runtime/logs concurrently -n web,api -c cyan,magenta \"vite --host 127.0.0.1 --port 8810\" \"nodemon --watch server --ext ts --exec tsx server/index.ts\"",
    "dev:docker": "concurrently -n web,api -c cyan,magenta \"cross-env VITE_DEV=1 vite --host 0.0.0.0 --port 8800\" \"cross-env VITE_DEV=1 HOST=0.0.0.0 nodemon --legacy-watch --watch server --ext ts --exec tsx server/index.ts\"",
    "dev:tailscale": "concurrently -n web,api -c cyan,magenta \"cross-env VITE_DEV=1 vite --host 0.0.0.0 --port 8800\" \"cross-env VITE_DEV=1 HOST=0.0.0.0 nodemon --watch server --ext ts --exec tsx server/index.ts\"",
    "start": "tsx server/index.ts",
    "start:tailscale": "cross-env HOST=0.0.0.0 tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "arch:map": "node scripts/generate-architecture-report.mjs",
    "preflight:public": "bash scripts/preflight-public.sh",
    "audit:verify": "node scripts/verify-security-audit-log.mjs",
    "test:comm:llm": "node scripts/qa/llm-comm-test.mjs",
    "test:comm:oauth": "node scripts/qa/oauth-comm-test.mjs",
    "test:comm:api": "node scripts/qa/api-comm-test.mjs",
    "test:comm:suite": "node scripts/qa/run-comm-suite.mjs",
    "test:comm-status": "node scripts/test-comm-status.mjs",
    "test:qa:office:smoke": "node scripts/qa/office-console-smoke.mjs",
    "test:qa:office:perf": "node scripts/qa/office-performance-baseline.mjs",
    "test:qa:office:resolutions": "node scripts/qa/office-resolution-compare.mjs",
    "test:qa:office:management": "node scripts/qa/office-management-requirements.mjs",
    "test:qa:office:theme": "node scripts/qa/office-theme-requirements.mjs",
    "test:qa:project-path": "node scripts/qa/project-path-api-smoke.mjs",
    "test:web": "vitest --config vitest.config.ts",
    "test:api": "vitest --config server/vitest.config.ts",
    "test:api:ci": "vitest --config server/vitest.ci.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --config playwright.config.ts",
    "test": "pnpm run test:web && pnpm run test:api",
    "test:ci:unit": "pnpm run test:web --coverage && pnpm run test:api:ci --coverage",
    "test:ci": "pnpm run test:ci:unit && pnpm run test:e2e",
    "lint": "eslint src server",
    "lint:fix": "eslint src server --fix",
    "lint:staged": "lint-staged",
    "openapi:sync": "node scripts/openapi-contract.mjs --write",
    "openapi:check": "node scripts/openapi-contract.mjs --check",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,scss,html}\""
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remotion/cli": "^4.0.478",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "imapflow": "^1.7.8",
    "js-yaml": "^4.1.1",
    "mailparser": "^3.9.20",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.1.1",
    "pino": "^10.3.1",
    "pixi.js": "^8.19.0",
    "playwright": "^1.61.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "remotion": "^4.0.478",
    "swagger-ui-express": "^5.0.1",
    "undici": "^8.5.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.4",
    "sharp": "^0.34.5",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^3.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css,scss,html}": "prettier --write",
    "{src/api,server/config}/**/*.ts": "eslint --fix --max-warnings=0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "readdirp>picomatch": "4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "hono@<4.12.21": ">=4.12.21",
      "hono": ">=4.12.21",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "protobufjs@<7.5.5": ">=7.5.5",
      "postcss@<8.5.18": ">=8.5.18",
      "ip-address": ">=10.3.1",
      "fast-uri": ">=4.1.4",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "js-yaml@<4.3.1": ">=4.3.1 <5",
      "browserslist@<4.28.7": ">=4.28.7",
      "nanoid@<3.3.18": ">=3.3.18",
      "undici@8": ">=8.9.0"
    }
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
